<%- include('../partials/head', {title:'考试总览 · 学生端'}) %>
<%- include('../partials/nav-student', {user: user, active: 'dashboard'}) %>
<div class="app">
  <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
    <h1 style="font-size:22px;font-weight:700;margin:0;"><%= data.name %> 的考试总览</h1>
    <span style="background:var(--accent);color:#fff;padding:4px 12px;border-radius:20px;font-size:13px;font-weight:600;">学年 <%= data.year %></span>
  </div>

  <!-- 学年选择 -->
  <div class="card" style="margin-bottom:16px;padding:14px 20px;">
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
      <label style="margin:0;font-weight:600;">学年：</label>
      <% if(years.length > 1){ %>
        <select id="yearSel" style="width:auto;min-width:180px;">
          <% years.forEach(y=>{ %>
            <option value="<%= y %>" <%= y===year?'selected':'' %>><%= y %><%= y===activeYear?'（当前学年）':'' %></option>
          <% }) %>
        </select>
        <span class="muted">切换学年可查看该学年的各科能力图与预测分</span>
      <% } else { %>
        <span style="background:var(--accent);color:#fff;padding:4px 12px;border-radius:20px;font-size:13px;font-weight:600;"><%= year %><%= year===activeYear?'（当前学年）':'' %></span>
        <span class="muted">你目前只有这一个学年的评分数据，暂无法切换</span>
      <% } %>
    </div>
  </div>

  <% if(data.subjects.length===0){ %>
    <div class="card"><p class="muted">暂无考试/评分数据, 请联系老师录入。</p></div>
  <% } %>

  <div id="examGrid" class="exam-grid"></div>
</div>

<script>
const ABILITIES = <%- JSON.stringify(abilities) %>;
const data = <%- JSON.stringify(data) %>;

const grid = document.getElementById('examGrid');
const charts = [];

data.subjects.forEach((s, idx) => {
  const hasScores = s.scores && s.scores.length === 6;
  const card = document.createElement('div');
  card.className = 'card exam-card';
  const badges = [];
  badges.push(s.prediction != null ? `<span class="badge ps-${s.prediction}">预测 ${s.prediction}</span>` : '');
  badges.push(s.actual != null ? `<span class="badge ps-${s.actual}">实际 ${s.actual}</span>` : '');
  card.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:8px;">
      <h3 style="margin:0;font-size:15px;">${s.subject}</h3>
      <div>${badges.join(' ')}</div>
    </div>
    <div style="height:230px;">
      <canvas id="hex-${idx}"></canvas>
    </div>
    ${ hasScores ? `<div class="hex-legend">` + s.scores.map((v,i)=>`<span class="pill">${ABILITIES[i].slice(0,2)} ${v}</span>`).join('') + `</div>` : '<p class="muted">暂未评分</p>' }
  `;
  grid.appendChild(card);

  if (hasScores) {
    const ctx = document.getElementById('hex-' + idx).getContext('2d');
    charts.push(new Chart(ctx, {
      type: 'radar',
      data: {
        labels: ABILITIES,
        datasets: [{
          label: s.subject,
          data: s.scores,
          fill: true,
          backgroundColor: 'rgba(59,130,246,0.18)',
          borderColor: '#3b82f6',
          pointBackgroundColor: '#3b82f6'
        }]
      },
      options: { scales: { r: { min: 1, max: 5, ticks: { stepSize: 1 } } }, plugins: { legend: { display: false } } }
    }));
  }
});

if (data.subjects.length === 0) {
  grid.innerHTML = '';
}

const yearSel = document.getElementById('yearSel');
if (yearSel) yearSel.onchange = () => { location.href = '/student/dashboard?year=' + encodeURIComponent(yearSel.value); };
</script>
<style>
.exam-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:16px; }
.exam-card { margin-bottom:0; }
.hex-legend { margin-top:10px; display:flex; flex-wrap:wrap; }
</style>
</body></html>
