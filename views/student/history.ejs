<%- include('../partials/head', {title:'历史记录 · 学生端'}) %>
<%- include('../partials/nav-student', {user: user, active: 'history'}) %>
<div class="app">
  <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
    <h1 style="font-size:22px;font-weight:700;margin:0;">历史记录</h1>
  </div>

  <% if(years && years.length > 1){ %>
  <div class="card" style="margin-bottom:16px;padding:14px 20px;">
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
      <label style="margin:0;font-weight:600;">学年筛选：</label>
      <select id="yearSel" style="width:auto;min-width:180px;">
        <option value="all" <%= year==='all'?'selected':'' %>>全部学年</option>
        <% years.forEach(y=>{ %>
          <option value="<%= y %>" <%= y===year?'selected':'' %>><%= y %></option>
        <% }) %>
      </select>
      <span class="muted">可只看某一学年，或查看全部学年的出分记录</span>
    </div>
  </div>
  <% } %>

  <div class="card">
    <h2>历年已出真实 AP 分的科目</h2>
    <table class="data"><thead><tr><th>学年</th><th>科目</th><th>实际分</th><th>系统预测</th><th>误差</th></tr></thead><tbody>
    <% history.forEach(h=>{ const err=Math.abs(h.actual-h.prediction); %>
      <tr><td><%= h.year %></td><td><%= h.subject %></td><td><strong><%= h.actual %></strong></td><td><%= h.prediction %></td><td><%= err.toFixed(1) %></td></tr>
    <% }) %>
    </tbody></table>
    <% if(history.length===0){ %><p class="muted">暂无已出分的记录。</p><% } %>
  </div>
</div>
<script>
(function () {
  var ys = document.getElementById('yearSel');
  if (ys) ys.onchange = function () { location.href = '/student/history?year=' + encodeURIComponent(ys.value); };
})();
</script>
</body></html>
