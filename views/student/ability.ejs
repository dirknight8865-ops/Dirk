<%- include('../partials/head', {title:'个人能力画像 · 学生端'}) %>
<%- include('../partials/nav-student', {user: user, active: 'ability'}) %>
<div class="app">
  <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
    <h1 style="font-size:22px;font-weight:700;margin:0;">个人能力画像</h1>
    <span style="background:var(--accent);color:#fff;padding:4px 12px;border-radius:20px;font-size:13px;font-weight:600;">学年 <%= data.year %></span>
  </div>

  <%- include('../partials/year-picker', {years, year, activeYear, base: '/student/ability', hint: '切换学年可查看该学年各科目的能力画像'}) %>

  <div class="card" style="margin-bottom:16px;">
    <div class="form-inline" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
      <label style="margin:0;">选择科目：</label>
      <select id="subjSel" style="min-width:260px;padding:8px 10px;border:1px solid var(--border);border-radius:6px;font-size:14px;">
        <% data.subjects.forEach(s=>{ %>
          <option value="<%= s.subject %>"><%= s.subject %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div id="panel" class="card" style="display:none;">
    <div class="grid2">
      <div>
        <h3 style="margin:0 0 10px;"><span id="pSubj"></span> · 能力六边形</h3>
        <div style="height:300px;"><canvas id="radar"></canvas></div>
      </div>
      <div>
        <h3 style="margin:0 0 10px;">六维明细</h3>
        <p class="muted" style="font-size:13px;margin:0 0 8px;">等级：1 严重不足 · 2 差 · 3 合格 · 4 良好 · 5 优。点每行「标准 ▾」查看该能力各档评价准则。</p>
        <div id="legend" style="display:flex;flex-wrap:wrap;margin-bottom:12px;"></div>
        <table class="data">
          <thead><tr><th>能力维度</th><th>评分(1-5)</th><th>预测/实际</th></tr></thead>
          <tbody id="tb"></tbody>
        </table>
      </div>
    </div>

    <div style="margin-top:20px;border-top:1px solid var(--border);padding-top:16px;">
      <h3 style="margin:0 0 4px;">扣分因子排行 · 谁在拉低你的预测分</h3>
      <p class="muted" style="font-size:13px;margin:0 0 12px;">能力分低于该科目合格线时，按「缺口 × 扣分率」扣减预测分。排名越靠前，对分数的拖累越大。</p>
      <div id="penaltyBox"></div>
    </div>
  </div>

  <% if(data.subjects.length===0){ %>
    <div class="card"><p class="muted">暂无评分数据, 请联系老师录入。</p></div>
  <% } %>
</div>

<script>
const ABILITIES = <%- JSON.stringify(abilities) %>;
const criteria = <%- JSON.stringify(criteria) %>;
const levelNames = <%- JSON.stringify(levelNames) %>;
const data = <%- JSON.stringify(data) %>;
let radarChart = null;

function showSubject(subject) {
  const s = data.subjects.find(x => x.subject === subject);
  if (!s) return;
  document.getElementById('panel').style.display = 'block';
  document.getElementById('pSubj').textContent = s.subject;

  // 图例 + 明细表
  const legend = document.getElementById('legend');
  const tb = document.getElementById('tb');
  legend.innerHTML = '';
  tb.innerHTML = '';
  const hasScores = s.scores && s.scores.length === 6;
  ABILITIES.forEach((a, i) => {
    const v = hasScores ? s.scores[i] : null;
    const pill = document.createElement('span');
    pill.className = 'pill';
    pill.textContent = a + ' ' + (v != null ? v : '-');
    legend.appendChild(pill);
    const c = criteria[a];
    const critHtml = c ? `<details class="crit"><summary class="crit-sum">标准 ▾</summary><div class="crit-body"><p class="crit-def">${c.def}</p>${[1,2,3,4,5].map(l=>`<div class="crit-lvl"><b>L${l} ${levelNames[l]}</b> ${c.levels[l]}</div>`).join('')}</div></details>` : '';
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${a}${critHtml}</td><td>${v != null ? v : '-'}</td><td>${s.prediction != null ? '预测 ' + s.prediction : '-'}${s.actual != null ? ' / 实际 ' + s.actual : ''}</td>`;
    tb.appendChild(tr);
  });

  // 雷达
  if (radarChart) radarChart.destroy();
  if (hasScores) {
    radarChart = new Chart(document.getElementById('radar').getContext('2d'), {
      type: 'radar',
      data: { labels: ABILITIES, datasets: [{ label: s.subject, data: s.scores, fill: true, backgroundColor: 'rgba(59,130,246,0.18)', borderColor: '#3b82f6', pointBackgroundColor: '#3b82f6' }] },
      options: { scales: { r: { min: 1, max: 5, ticks: { stepSize: 1 } } }, plugins: { legend: { display: false } } }
    });
  }

  // 扣分因子排行榜
  renderPenalty(s);
}

function renderPenalty(s) {
  const pb = document.getElementById('penaltyBox');
  if (!pb) return;
  const hasScores = s.scores && s.scores.length === 6;
  if (!hasScores) {
    pb.innerHTML = '<p class="muted">暂无评分数据，无法计算扣分。</p>';
    return;
  }
  if (!s.penaltyList || s.penaltyList.length === 0) {
    pb.innerHTML = '<div style="background:#f0fdf4;border:1px solid #86efac;border-radius:8px;padding:14px 16px;color:#166534;">' +
      '<b>该科目暂无扣分项</b><br><span style="font-size:13px;">你的六维能力均达到该科目合格线（' + s.threshold + ' 分），预测分没有被任何因素拉低。</span></div>';
    return;
  }
  const total = s.penaltyTotal;
  const barColor = i => i === 0 ? '#ef4444' : i === 1 ? '#f59e0b' : i === 2 ? '#3b82f6' : '#94a3b8';
  const items = s.penaltyList.map((p, i) => {
    const pct = total > 0 ? Math.max(2, Math.round(p.contribution / total * 100)) : 0;
    return '<div style="display:flex;align-items:center;gap:12px;padding:10px 12px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px;">' +
      '<span style="min-width:26px;height:26px;border-radius:50%;background:' + barColor(i) + ';color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;">' + (i + 1) + '</span>' +
      '<div style="flex:1;min-width:0;">' +
        '<div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;">' +
          '<span style="font-weight:600;">' + p.ability + ' <span class="muted" style="font-weight:400;">当前 ' + p.score + ' 分</span></span>' +
          '<span style="font-weight:700;color:#b91c1c;">扣 ' + p.contribution + ' 分（占 ' + Math.round(p.contribution / total * 100) + '%）</span>' +
        '</div>' +
        '<div style="background:var(--border);height:6px;border-radius:3px;margin-top:6px;overflow:hidden;">' +
          '<div style="width:' + pct + '%;background:' + barColor(i) + ';height:100%;border-radius:3px;"></div>' +
        '</div>' +
        '<div class="muted" style="font-size:12px;margin-top:4px;">低于合格线 ' + p.shortfall + ' 分 × 扣分率 ' + p.rate + ' = 扣 ' + p.contribution + ' 分</div>' +
      '</div></div>';
  }).join('');
  pb.innerHTML = '<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:12px 16px;margin-bottom:12px;font-size:14px;">' +
      '以下 <b>' + s.penaltyList.length + '</b> 个因素合计拉低你 <b style="color:#b91c1c;">' + total + '</b> 分；若消除全部扣分，你的预测分将是 <b style="color:#166534;">' + s.noPenaltyPrediction + '</b> 分。</div>' + items +
    '<p class="muted" style="font-size:13px;margin:8px 0 0;">💡 从第 1 名开始补起——它对预测分的拖累最大。完整先后排序见「提升路径」页。</p>';
}

const sel = document.getElementById('subjSel');
if (sel) {
  sel.addEventListener('change', e => showSubject(e.target.value));
  showSubject(sel.value);
}
</script>
</body></html>
