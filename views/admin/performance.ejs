<%- include('../partials/head', {title:'表现分析 · 后台'}) %>
<%- include('../partials/nav-admin', {user: user, active: 'performance'}) %>
<div class="app">
  <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
    <h1 style="font-size:22px;font-weight:700;margin:0;">表现分析</h1>
    <span style="background:var(--accent);color:#fff;padding:4px 12px;border-radius:20px;font-size:13px;font-weight:600;">学年 <%= year %></span>
    <span class="muted" style="font-size:13px;">已毕业学生也参与对比（徽章标注）</span>
  </div>

  <div class="form-inline" style="gap:8px;flex-wrap:wrap;margin-bottom:16px;">
    <label style="margin:0;">学年</label>
    <select id="yearSel" style="max-width:180px;"></select>
    <span style="width:12px;"></span>
    <label style="margin:0;">视图</label>
    <select id="viewSel" style="max-width:260px;">
      <option value="horizontal">横向 · 按科目对比不同学生</option>
      <option value="vertical">纵向 · 按学生对比不同学科</option>
      <option value="compare">学生间 · 多人对比</option>
    </select>
  </div>

  <!-- ① 横向视图 -->
  <div id="view-horizontal">
    <div class="form-row" style="max-width:360px;"><label>科目</label><select id="hSubjSel"></select></div>
    <div class="row">
      <div class="col card">
        <h2>学生表现排名（<span id="hSubjName"></span>）</h2>
        <p class="muted" style="font-size:13px;">按预测 AP 分降序。班级均分：<b id="hClassAvg">-</b></p>
        <div class="table-wrap"><table class="data"><thead><tr><th>#</th><th>学生</th><th>年级</th><th>六维均分</th><th>预测</th><th>实际</th></tr></thead><tbody id="hBody"></tbody></table></div>
      </div>
      <div class="col card">
        <h2>预测分对比</h2>
        <div class="chart-box"><canvas id="hChart"></canvas></div>
      </div>
    </div>
  </div>

  <!-- ② 纵向视图 -->
  <div id="view-vertical" style="display:none;">
    <div class="form-row" style="max-width:360px;"><label>学生</label><select id="vStuSel"></select></div>
    <div class="row">
      <div class="col card">
        <h2>六维能力画像（全科平均）</h2>
        <div class="chart-box"><canvas id="vRadar"></canvas></div>
      </div>
      <div class="col card">
        <h2>各学科表现</h2>
        <div class="table-wrap"><table class="data"><thead><tr><th>科目</th><th>六维均分</th><th>预测</th><th>实际</th><th>误差</th></tr></thead><tbody id="vBody"></tbody></table></div>
      </div>
    </div>
    <div class="card" style="margin-top:16px;">
      <h2>各科六维分明细</h2>
      <div class="table-wrap"><table class="data"><thead><tr id="vMatrixHead"></tr></thead><tbody id="vMatrixBody"></tbody></table></div>
    </div>
  </div>

  <!-- ③ 学生间对比视图 -->
  <div id="view-compare" style="display:none;">
    <div class="card" style="margin-bottom:16px;">
      <h2>选择对比学生（最多 6 人，含已毕业）</h2>
      <div id="cStuList" style="display:flex;flex-wrap:wrap;gap:8px;"></div>
    </div>
    <div class="row">
      <div class="col card">
        <h2>六维能力叠加对比</h2>
        <div class="chart-box"><canvas id="cRadar"></canvas></div>
      </div>
      <div class="col card">
        <h2>预测分叠加对比</h2>
        <div class="chart-box"><canvas id="cBar"></canvas></div>
      </div>
    </div>
    <div class="card" style="margin-top:16px;">
      <h2>对比明细</h2>
      <div class="table-wrap"><table class="data"><thead><tr id="cHead"></tr></thead><tbody id="cBody"></tbody></table></div>
    </div>
  </div>
</div>

<script>
const ABILITIES = <%- JSON.stringify(abilities) %>;
const COURSE_NAMES = <%- JSON.stringify(courseNames) %>;
const YEARS = <%- JSON.stringify(years) %>;
const ACTIVE_YEAR = <%- JSON.stringify(activeYear) %>;
const COLORS = ['#3b82f6', '#ef4444', '#10b981', '#f59e0b', '#8b5cf6', '#06b6d4'];
let hChart = null, vRadar = null, cRadar = null, cBar = null;
let allStudents = [];

function curYear(){ return document.getElementById('yearSel').value || ACTIVE_YEAR; }

async function loadStudents(){
  const r = await (await fetch('/admin/api/students')).json();
  allStudents = (r.data || []).map(s => ({ name: s.name, grade: s.grade, graduated: s.graduated }));
}

// ── 横向 ──
async function loadHorizontal(){
  const subj = document.getElementById('hSubjSel').value;
  document.getElementById('hSubjName').textContent = subj || '全部';
  if (!subj) { document.getElementById('hBody').innerHTML = '<tr><td colspan="6" class="muted">请选择科目</td></tr>'; return; }
  const r = await (await fetch('/admin/api/performance/horizontal?year=' + encodeURIComponent(curYear()) + '&subject=' + encodeURIComponent(subj))).json();
  document.getElementById('hClassAvg').textContent = r.classAvg != null ? r.classAvg : '-';
  const tb = document.getElementById('hBody'); tb.innerHTML = '';
  r.rows.forEach(row => {
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${row.rank}</td><td>${row.name}${row.graduated ? ' <span class="badge" style="background:#6b7280;color:#fff;">已毕业</span>' : ''}</td>` +
      `<td>${row.grade || '-'}</td><td>${row.avg}</td><td><span class="badge ps-${row.prediction}">${row.prediction}</span></td><td>${row.actual != null ? row.actual : '-'}</td>`;
    tb.appendChild(tr);
  });
  if (hChart) hChart.destroy();
  const ctx = document.getElementById('hChart').getContext('2d');
  hChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: r.rows.map(x => x.name),
      datasets: [{
        label: '预测 AP 分', data: r.rows.map(x => x.prediction),
        backgroundColor: r.rows.map(x => x.graduated ? '#9ca3af' : '#3b82f6'), borderRadius: 4
      }]
    },
    options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { min: 0, max: 5, ticks: { stepSize: 1 } } } }
  });
}

// ── 纵向 ──
async function loadVertical(){
  const name = document.getElementById('vStuSel').value;
  if (!name) return;
  const r = await (await fetch('/admin/api/performance/vertical?year=' + encodeURIComponent(curYear()) + '&name=' + encodeURIComponent(name))).json();
  if (vRadar) vRadar.destroy();
  vRadar = new Chart(document.getElementById('vRadar').getContext('2d'), {
    type: 'radar',
    data: { labels: ABILITIES, datasets: [{ label: name, data: r.avg6, fill: true, backgroundColor: 'rgba(59,130,246,0.18)', borderColor: '#3b82f6', pointBackgroundColor: '#3b82f6' }] },
    options: { scales: { r: { min: 1, max: 5, ticks: { stepSize: 1 } } }, plugins: { legend: { display: false } } }
  });
  const tb = document.getElementById('vBody'); tb.innerHTML = '';
  r.rows.forEach(row => {
    const tr = document.createElement('tr');
    const errBadge = row.err == null ? '-' : (row.err >= 0 ? `<span class="badge good">+${row.err}</span>` : `<span class="badge" style="background:#ef4444;color:#fff;">${row.err}</span>`);
    tr.innerHTML = `<td>${row.subject}</td><td>${row.avg}</td><td><span class="badge ps-${row.prediction}">${row.prediction}</span></td><td>${row.actual != null ? row.actual : '-'}</td><td>${errBadge}</td>`;
    tb.appendChild(tr);
  });
  // 六维矩阵
  document.getElementById('vMatrixHead').innerHTML = '<th>科目</th>' + ABILITIES.map(a => `<th>${a.slice(0, 2)}</th>`).join('');
  const mb = document.getElementById('vMatrixBody'); mb.innerHTML = '';
  r.rows.forEach(row => {
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${row.subject}</td>` + row.scores.map(v => `<td>${v}</td>`).join('');
    mb.appendChild(tr);
  });
}

// ── 学生间对比 ──
function renderStuPicker(){
  const box = document.getElementById('cStuList');
  box.innerHTML = '';
  allStudents.forEach((s, i) => {
    const label = document.createElement('label');
    label.style.cssText = 'display:inline-flex;align-items:center;gap:4px;padding:6px 10px;border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:13px;';
    label.innerHTML = `<input type="checkbox" value="${s.name}" ${i < 3 ? 'checked' : ''}> ${s.name}${s.graduated ? '（已毕业）' : ''}${s.grade ? ' · ' + s.grade : ''}`;
    box.appendChild(label);
  });
  box.querySelectorAll('input').forEach(cb => cb.onchange = () => {
    const checked = [...box.querySelectorAll('input:checked')];
    if (checked.length > 6) { cb.checked = false; alert('最多选择 6 人对比'); return; }
    loadCompare();
  });
}
function selectedNames(){
  return [...document.querySelectorAll('#cStuList input:checked')].map(x => x.value);
}
async function loadCompare(){
  const names = selectedNames();
  if (!names.length) return;
  const r = await (await fetch('/admin/api/performance/compare?year=' + encodeURIComponent(curYear()) + '&names=' + encodeURIComponent(names.join(',')))).json();
  // 叠加雷达: 每人六维全科均分
  const datasets = r.students.map((s, i) => {
    const vec = ABILITIES.map((_, ai) => {
      const vals = Object.values(s.subjects).map(v => v.scores[ai]);
      return vals.length ? +(vals.reduce((a, b) => a + b, 0) / vals.length).toFixed(2) : null;
    });
    return { label: s.name + (s.graduated ? '(已毕业)' : ''), data: vec, borderColor: COLORS[i], backgroundColor: COLORS[i] + '2e', pointBackgroundColor: COLORS[i], fill: true };
  }).filter(d => d.data.some(v => v != null));
  if (cRadar) cRadar.destroy();
  cRadar = new Chart(document.getElementById('cRadar').getContext('2d'), {
    type: 'radar', data: { labels: ABILITIES, datasets },
    options: { scales: { r: { min: 1, max: 5, ticks: { stepSize: 1 } } } }
  });
  // 叠加条形: 各科预测分
  if (cBar) cBar.destroy();
  cBar = new Chart(document.getElementById('cBar').getContext('2d'), {
    type: 'bar',
    data: {
      labels: r.subjects,
      datasets: r.students.map((s, i) => ({
        label: s.name + (s.graduated ? '(已毕业)' : ''),
        data: r.subjects.map(sj => (s.subjects[sj] ? s.subjects[sj].prediction : null)),
        backgroundColor: COLORS[i], borderRadius: 3
      }))
    },
    options: { plugins: { legend: { position: 'bottom' } }, scales: { y: { min: 0, max: 5, ticks: { stepSize: 1 } } } }
  });
  // 对比明细表
  document.getElementById('cHead').innerHTML = '<th>学生</th>' + r.subjects.map(sj => `<th>${sj}</th>`).join('') + '<th>六维总均分</th><th>预测均分</th>';
  const cb = document.getElementById('cBody'); cb.innerHTML = '';
  r.students.forEach(s => {
    const tr = document.createElement('tr');
    const cells = r.subjects.map(sj => {
      const v = s.subjects[sj];
      return v ? `<td><span class="badge ps-${v.prediction}">${v.prediction}</span>${v.actual != null ? ' / 实际 ' + v.actual : ''}</td>` : '<td>-</td>';
    }).join('');
    tr.innerHTML = `<td>${s.name}${s.graduated ? ' <span class="badge" style="background:#6b7280;color:#fff;">已毕业</span>' : ''}</td>${cells}<td>${s.avg6 != null ? s.avg6 : '-'}</td><td>${s.avgPred != null ? s.avgPred : '-'}</td>`;
    cb.appendChild(tr);
  });
}

// ── 视图切换与初始化 ──
function switchView(){
  const v = document.getElementById('viewSel').value;
  ['horizontal', 'vertical', 'compare'].forEach(k => {
    document.getElementById('view-' + k).style.display = k === v ? 'block' : 'none';
  });
  if (v === 'horizontal') loadHorizontal();
  else if (v === 'vertical') loadVertical();
  else loadCompare();
}

(async function init(){
  const ys = document.getElementById('yearSel');
  ys.innerHTML = YEARS.map(y => `<option value="${y}">${y}</option>`).join('');
  ys.value = ACTIVE_YEAR;
  await loadStudents();
  // 科目下拉: 从该学年实际数据收集(含自定义科目)
  const r0 = await (await fetch('/admin/api/performance/horizontal?year=' + encodeURIComponent(ACTIVE_YEAR))).json();
  const hs = document.getElementById('hSubjSel');
  hs.innerHTML = '<option value="">请选择科目</option>' + (r0.subjects || []).map(c => `<option value="${c}">${c}</option>`).join('');
  hs.onchange = loadHorizontal;
  // 学生下拉(纵向)
  const vs = document.getElementById('vStuSel');
  vs.innerHTML = '<option value="">请选择学生</option>' + allStudents.map(s => `<option value="${s.name}">${s.name}${s.graduated ? '（已毕业）' : ''}</option>`).join('');
  vs.onchange = loadVertical;
  ys.onchange = () => { switchView(); };
  document.getElementById('viewSel').onchange = switchView;
  renderStuPicker();
  switchView();
})();
</script>
</body></html>
