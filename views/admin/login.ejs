<%- include('../partials/head', {title:'管理员登录'}) %>
<div class="login-wrap card">
  <h2>管理员登录</h2>
  <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>
  <form method="POST" action="/login">
    <div class="form-row"><label>用户名</label><input name="username" required></div>
    <div class="form-row"><label>密码</label><input name="password" type="password" required></div>
    <button class="btn btn-block">登录</button>
  </form>
  <p class="muted" style="margin-top:12px;">学生请前往 <a href="/student/login">学生登录</a></p>
</div>
</body></html>
